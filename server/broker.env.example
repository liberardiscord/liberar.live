# Pool entregue dinamicamente aos clientes. O nome à esquerda deve ser igual ao
# `services[].name` do GOST e ao PROXY_NODE_NAME do reaper naquele nó.
BROKER_PROXY_NODES=socks5=proxy-us-1.example:1080

BROKER_API_LISTEN=127.0.0.1:8080
BROKER_AUTH_LISTEN=127.0.0.1:8000
BROKER_REDIS_ADDR=127.0.0.1:6379
BROKER_SESSION_TTL=6m
BROKER_POW_DIFFICULTY=20
